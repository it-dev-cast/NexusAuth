# Development placeholders only - never commit real values.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
# Only HS256 is supported (shared-secret HMAC) — this app has no RSA
# keypair loading, so RS256/other algorithms fail validation at startup.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# Brute-force protection: an account is locked for ACCOUNT_LOCKOUT_MINUTES
# after MAX_FAILED_LOGIN_ATTEMPTS consecutive wrong-password attempts.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Comma-separated list of allowed cross-origin frontends, e.g.
# "https://app.example.com,https://admin.example.com". Empty by default —
# this app's own frontend is served same-origin from /static, so no
# cross-origin access is needed unless a separately-hosted frontend exists.
CORS_ALLOWED_ORIGINS=

# Optional deploy metadata surfaced on GET /health so an on-call engineer
# or deploy pipeline can confirm which build is serving traffic.
BUILD_TIMESTAMP=
GIT_SHA=

# Optional. Enables field-level encryption at rest for Employee PII (bank
# account number, IFSC, PAN, Aadhaar, document references). Must be a
# Fernet key — generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, these fields are stored in plain text and a startup warning is
# logged. See SECURITY_CHECKLIST.md.
PII_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/nexus_auth
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_auth
# How long a new DB connection attempt can hang, and how long any single
# query can run, before it's aborted — prevents a hung connect or a
# runaway query from blocking a worker indefinitely. Sane defaults; only
# override if you know you need to.
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# Optional. The test suite (app/tests/conftest.py) never runs against the
# database above — it derives "<DATABASE_URL>_test" automatically unless
# this is set explicitly. Run `python scripts/create_test_db.py` once to
# create and migrate it.
TEST_DATABASE_URL=

# Key rotation. When you change JWT_SECRET_KEY, put the OLD value here
# (comma-separated) so tokens it signed keep working until they expire;
# remove it after REFRESH_TOKEN_EXPIRE_DAYS. Same idea for PII: old Fernet
# keys here still decrypt existing values, new writes use PII_ENCRYPTION_KEY.
JWT_PREVIOUS_SECRET_KEYS=
PII_PREVIOUS_ENCRYPTION_KEYS=

# development | test | staging | production. "production" refuses to start
# without PII_ENCRYPTION_KEY or with CORS_ALLOWED_ORIGINS containing "*".
# Strict-Transport-Security max-age in seconds; 0 = header not sent. Turn on
# only once HTTPS is terminated in front of the app.
HSTS_MAX_AGE_SECONDS=0

# Password for admin@casterly.com, created only when the users table is
# empty at startup. Unset = no account is created (use scripts/seed_admin.py).
BOOTSTRAP_ADMIN_PASSWORD=
